# Variables del backend. Copiar a .env y completar. NUNCA subir el .env al repo.
#
# Cada variable lleva dos marcas que lee scripts/revisar_env.mjs:
#   [obligatoria] / [opcional]
#   [secreto]  nueva en cada instancia; jamás se copia de otra ni se comparte
#   [instancia] cambia por clínica o por entorno (URLs, base, cuentas)
#   [fija]     igual en todas; dejar vacía usa el valor por omisión indicado
#
# Revisar una instancia sin mostrar ningún valor:  node scripts/revisar_env.mjs

# ── Servidor ───────────────────────────────────────────────────────────────────
# [obligatoria][fija] "production" en el servidor (Express oculta detalles de errores).
NODE_ENV=production
# [obligatoria][instancia] Puerto donde escucha (nginx le reenvía). Cada instancia el suyo.
PORT=

# ── Base de datos (MySQL) ─────────────────────────────────────────────────────
# [obligatoria][instancia] Servidor MySQL.
DB_HOST=
# [opcional][instancia] Puerto MySQL (3306).
DB_PORT=
# [obligatoria][instancia] Usuario de la aplicación (no root).
DB_USER=
# [obligatoria][secreto] Contraseña de ese usuario.
DB_PASS=
# [obligatoria][instancia] Base de esta clínica.
DB_DATABASE=
# [opcional][fija] Conexiones simultáneas del pool (5).
DB_POOL_LIMIT=

# ── URLs de esta instancia ────────────────────────────────────────────────────
# [obligatoria][instancia] Front público, p. ej. https://clinica.agendaclinicas.cl (QR de verificación, .ics).
URL_PUBLICA_SITIO=
# [obligatoria][instancia] Front al que vuelve Mercado Pago después del pago.
FRONT_URL=
# [obligatoria][instancia] Este backend, p. ej. https://back.clinica.agendaclinicas.cl (webhooks y enlaces de confirmar/cancelar).
BACKEND_URL=
# [obligatoria][instancia] Orígenes que pueden llamar desde el navegador, separados por coma. Sin rutas.
CORS_ORIGENES=

# ── Sesión (Clerk) ────────────────────────────────────────────────────────────
# [obligatoria][secreto] sk_live_… de la instancia de Clerk de esta clínica. Va con la pk del front.
CLERK_SECRET_KEY=
# [opcional][fija] Tiempo máximo de espera a Clerk en ms (8000).
CLERK_TIEMPO_LIMITE_MS=

# ── Archivos (Cloudflare R2) ──────────────────────────────────────────────────
# [obligatoria][instancia] https://<cuenta>.r2.cloudflarestorage.com
R2_ENDPOINT=
# [obligatoria][instancia] Bucket de esta clínica (privado).
R2_BUCKET=
# [obligatoria][secreto]
R2_ACCESS_KEY=
# [obligatoria][secreto]
R2_SECRET_KEY=
# [opcional][fija] Tiempo máximo de cada operación con R2 en ms (15000).
R2_TIEMPO_LIMITE_MS=

# ── Imágenes (Cloudflare Images: fotos de profesionales y del sitio) ──────────
# [obligatoria][instancia]
ACCOUNT_ID=
# [obligatoria][instancia] Hash de entrega de imágenes.
ACCOUNT_HASH=
# [obligatoria][secreto]
API_TOKEN_CLOUDFLARE=

# ── Correo (Brevo) ────────────────────────────────────────────────────────────
# [obligatoria][secreto]
BREVO_API_KEY=
# [obligatoria][instancia] Remitente verificado en Brevo.
CORREO_REMITENTE=
# [opcional][instancia] Nombre en los correos al profesional si la clínica no lo cargó en la página ("Agenda Clínica").
NOMBRE_EMPRESA=

# ── WhatsApp, SMS y videollamada (Twilio) — sin esto no hay WhatsApp ni videollamada ──
# [opcional][secreto]
TWILIO_ACCOUNT_SID=
# [opcional][secreto]
TWILIO_AUTH_TOKEN=
# [opcional][instancia] whatsapp:+56…
TWILIO_WHATSAPP_FROM=
# [opcional][instancia] Plantilla de confirmación de cita.
TWILIO_CONTENT_SID=
# [opcional][instancia] Plantilla de recordatorio.
TWILIO_CONTENT_SID_RECORDATORIO=
# [opcional][instancia] Plantilla de código de un uso (categoría Autenticación en Meta).
TWILIO_CONTENT_SID_OTP=
# [opcional][fija] Botones de la plantilla: quick_reply o url (quick_reply).
TWILIO_TEMPLATE_BUTTON_MODE=
# [opcional][instancia] Número habilitado para SMS (respaldo del código de un uso).
TWILIO_SMS_FROM=
# [opcional][secreto] Videollamada: API key SK…
TWILIO_API_KEY=
# [opcional][secreto] Videollamada: secreto de esa API key.
TWILIO_API_SECRET=

# ── Enlaces de confirmar/cancelar cita ────────────────────────────────────────
# [obligatoria][secreto] Firma los enlaces. 32+ caracteres: openssl rand -base64 48
NOTIFICACION_TOKEN_SECRET=

# ── Firma electrónica ─────────────────────────────────────────────────────────
# [obligatoria][secreto] Sella la evidencia. 32+ caracteres: openssl rand -base64 48. Guardarla FUERA del servidor.
FIRMA_HMAC_CLAVE=
# [opcional][fija] Versión de la clave (1). Sube al rotarla.
FIRMA_HMAC_VERSION=
# [opcional][secreto] Claves anteriores tras una rotación, JSON {"1":"…"}.
FIRMA_HMAC_CLAVES_ANTERIORES=
# [opcional][fija] "0" apaga la firma sin desplegar (interruptor de emergencia).
FIRMA_HABILITADA=
# [opcional][fija] Minutos de validez de la reverificación con contraseña (10).
FIRMA_REVERIFICACION_MIN=
# [opcional][fija] Firmas generándose a la vez (2).
FIRMA_CONCURRENCIA=
# [opcional][fija] Días hasta el aviso de un documento sin firmar (7).
FIRMA_AVISO_DIAS=
# [opcional][fija] Días hasta que se anula un documento sin firmar (30).
FIRMA_VENCE_DIAS=
# [opcional][fija] Horas hasta que se anula un consentimiento sin firmar (24).
FIRMA_VENCE_CONSENTIMIENTO_HORAS=
# [opcional][fija] "1" imprime una vez el claim fva del token (diagnóstico).
FIRMA_DEPURAR_FVA=

# ── Notificaciones push del navegador ─────────────────────────────────────────
# [opcional][instancia] npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
# [opcional][secreto]
VAPID_PRIVATE_KEY=

# ── Operación (Fase 8: cron, respaldos, alertas) ──────────────────────────────
# [obligatoria][instancia] Correo de alertas del cron (varios separados por coma).
ALERTA_CORREO=
# [opcional][fija] Carpeta de respaldos locales (~/respaldos/diario).
RESPALDO_DIR=
# [opcional][fija] Días que se guardan los respaldos (30).
RESPALDO_DIAS=
# [opcional][secreto] Protege GET /health-metrics.
HEALTH_METRICS_API_KEY=

# ── Solo para scripts de prueba (no van en el servidor) ───────────────────────
# [opcional][fija]
TEST_API_KEY=
# [opcional][fija]
TEST_RESERVA_BASE_URL=
# [opcional][fija]
TEST_RESERVA_CONCURRENCY=
# [opcional][fija]
TEST_RESERVA_FECHA=
# [opcional][fija]
TEST_RESERVA_HORA_INICIO=
# [opcional][fija]
TEST_RESERVA_HORA_FIN=
# [opcional][fija]
TEST_RESERVA_ID_PROFESIONAL=
